<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Assembler.RemoteTooling</RootNamespace>
    <AssemblyName>assembler-remote</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Single source of truth for the daemon/CLI version. Bump on each meaningful
         change so a deployed daemon can be asked (`assembler-remote version`) which
         build is actually running. -->
    <Version>1.0.2</Version>
    <!-- No NuGet dependencies: GitHub goes through the `gh` CLI (already the auth story),
         manifest.json through System.Text.Json, and `claude`/`validate-game.sh` through Process. -->
  </PropertyGroup>

</Project>
